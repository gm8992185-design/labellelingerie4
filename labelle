        // Modal de Tamanhos
        function openSizeGuideModal() {
            document.getElementById('size-guide-modal').classList.remove('hidden');
        }
        function closeSizeGuideModal() {
            document.getElementById('size-guide-modal').classList.add('hidden');
        }

        // Carrinho de Compras
        function addToCart(productId, size = 'M') {
            const product = products.find(p => p.id === productId);
            const cartItemIndex = cart.findIndex(item => item.id === productId && item.size === size);

            if (cartItemIndex > -1) {
                cart[cartItemIndex].quantity += 1;
            } else {
                cart.push({ ...product, quantity: 1, size: size });
            }

            updateCartUI();
            showToast(`"${product.name}" no carrinho!`);
        }

        function removeFromCart(productId, size) {
            cart = cart.filter(item => !(item.id === productId && item.size === size));
            updateCartUI();
        }

        function changeQuantity(productId, size, delta) {
            const item = cart.find(i => i.id === productId && i.size === size);
            if (item) {
                item.quantity += delta;
                if (item.quantity <= 0) {
                    removeFromCart(productId, size);
                } else {
                    updateCartUI();
                }
            }
        }

        function updateCartUI() {
            const totalCount = cart.reduce((sum, item) => sum + item.quantity, 0);
            cartCount.innerText = totalCount;

            cartItemsContainer.innerHTML = '';

            if (cart.length === 0) {
                cartItemsContainer.innerHTML = `
                    <div class="text-center py-12 text-stone-400">
                        <i class="fa-solid fa-bag-shopping text-4xl mb-3 opacity-30 text-marsala"></i>
                        <p class="text-sm">Seu carrinho está vazio.</p>
                    </div>
                `;
            } else {
                cart.forEach(item => {
                    const itemEl = document.createElement('div');
                    itemEl.className = "pt-4 flex items-center space-x-4";
                    itemEl.innerHTML = `
                        <img src="${item.image}" alt="${item.name}" class="w-16 h-20 object-cover rounded-lg">
                        <div class="flex-1">
                            <h4 class="text-xs font-bold text-stone-800 line-clamp-1">${item.name}</h4>
                            <span class="text-[10px] text-stone-500 uppercase font-semibold">Tamanho: ${item.size}</span>
                            <div class="text-xs font-semibold text-marsala-deep mt-1">R$ ${(item.price * item.quantity).toFixed(2).replace('.', ',')}</div>
                            <div class="flex items-center space-x-2 mt-2">
                                <button onclick="changeQuantity(${item.id}, '${item.size}', -1)" class="w-5 h-5 bg-stone-200 rounded flex items-center justify-center text-xs font-bold text-stone-700">-</button>
                                <span class="text-xs font-medium">${item.quantity}</span>
                                <button onclick="changeQuantity(${item.id}, '${item.size}', 1)" class="w-5 h-5 bg-stone-200 rounded flex items-center justify-center text-xs font-bold text-stone-700">+</button>
                            </div>
                        </div>
                        <button onclick="removeFromCart(${item.id}, '${item.size}')" class="text-stone-300 hover:text-red-500 text-xs p-1"><i class="fa-solid fa-trash"></i></button>
                    `;
                    cartItemsContainer.appendChild(itemEl);
                });
            }

            const rawSubtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
            const discountAmount = rawSubtotal * discountPercentage;
            const finalTotal = rawSubtotal - discountAmount;

            cartSubtotal.innerText = `R$ ${rawSubtotal.toFixed(2).replace('.', ',')}`;
            if (discountPercentage > 0) {
                document.getElementById('discount-row').classList.remove('hidden');
                document.getElementById('cart-discount').innerText = `- R$ ${discountAmount.toFixed(2).replace('.', ',')}`;
            } else {
                document.getElementById('discount-row').classList.add('hidden');
            }
            cartTotal.innerText = `R$ ${finalTotal.toFixed(2).replace('.', ',')}`;
        }

        // Cupom de desconto
        document.getElementById('apply-coupon-btn').addEventListener('click', () => {
            const couponInput = document.getElementById('coupon-input').value.trim().toUpperCase();
            if (couponInput === 'LABELLE10') {
                discountPercentage = 0.10;
                document.getElementById('coupon-applied-msg').classList.remove('hidden');
                updateCartUI();
                showToast("Cupom de 10% OFF Aplicado!");
            } else {
                showToast("Cupom inválido ou expirado.");
            }
        });

        // Checkout via WhatsApp
        document.getElementById('whatsapp-checkout-btn').addEventListener('click', () => {
            if (cart.length === 0) {
                showToast("Seu carrinho está vazio!");
                return;
            }

            let message = "*Novo Pedido - La Belle Lingerie*\n\n";
            cart.forEach((item, index) => {
                message += `${index + 1}. *${item.name}*\n   • Tam: ${item.size} | Qtd: ${item.quantity} | R$ ${(item.price * item.quantity).toFixed(2).replace('.', ',')}\n`;
            });

            const rawSubtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
            const discountAmount = rawSubtotal * discountPercentage;
            const finalTotal = rawSubtotal - discountAmount;

            message += `\n*Subtotal:* R$ ${rawSubtotal.toFixed(2).replace('.', ',')}`;
            if (discountPercentage > 0) {
                message += `\n*Desconto (LABELLE10):* -R$ ${discountAmount.toFixed(2).replace('.', ',')}`;
            }
            message += `\n*Total do Pedido:* R$ ${finalTotal.toFixed(2).replace('.', ',')}\n\n`;
            message += "Gostaria de finalizar o meu pedido e verificar as opções de pagamento e entrega! ✨";

            const whatsappUrl = `https://wa.me/5564984792747?text=${encodeURIComponent(message)}`;
            window.open(whatsappUrl, '_blank');
        });

        // Favoritos
        function toggleFavorite(productId) {
            const index = favorites.indexOf(productId);
            if (index > -1) {
                favorites.splice(index, 1);
                showToast("Item removido dos favoritos.");
            } else {
                favorites.push(productId);
                showToast("Item adicionado aos favoritos!");
            }
            const favCountEl = document.getElementById('fav-count');
            favCountEl.innerText = favorites.length;
            favCountEl.classList.toggle('hidden', favorites.length === 0);
            renderProducts();
        }

        // Toggle Drawer Carrinho
        function toggleCartDrawer(open) {
            if (open) {
                cartOverlay.classList.remove('hidden');
                setTimeout(() => {
                    cartOverlay.classList.remove('opacity-0');
                    cartDrawer.classList.remove('translate-x-full');
                }, 10);
            } else {
                cartDrawer.classList.add('translate-x-full');
                cartOverlay.classList.add('opacity-0');
                setTimeout(() => {
                    cartOverlay.classList.add('hidden');
                }, 300);
            }
        }

        cartBtn.addEventListener('click', () => toggleCartDrawer(true));
        closeCartBtn.addEventListener('click', () => toggleCartDrawer(false));
        cartOverlay.addEventListener('click', (e) => {
            if (e.target === cartOverlay) toggleCartDrawer(false);
        });

        // Toast Feedback
        function showToast(msg) {
            toastMessage.innerText = msg;
            toast.classList.remove('hidden');
            setTimeout(() => {
                toast.classList.add('hidden');
            }, 3000);
        }

        // Filtros de Categoria Event Listener
        document.querySelectorAll('#filter-buttons .filter-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                document.querySelectorAll('#filter-buttons .filter-btn').forEach(b => {
                    b.classList.remove('active', 'bg-marsala', 'text-white');
                    b.classList.add('bg-white', 'text-stone-700');
                });
                e.target.classList.add('active', 'bg-marsala', 'text-white');
                e.target.classList.remove('bg-white', 'text-stone-700');

                renderProducts(e.target.dataset.filter);
            });
        });

        // Barra de Busca
        const searchBtn = document.getElementById('search-btn');
        const searchBar = document.getElementById('search-bar');
        const closeSearch = document.getElementById('close-search');
        const searchInput = document.getElementById('search-input');

        searchBtn.addEventListener('click', () => {
            searchBar.classList.toggle('hidden');
            if (!searchBar.classList.contains('hidden')) searchInput.focus();
        });

        closeSearch.addEventListener('click', () => searchBar.classList.add('hidden'));

        searchInput.addEventListener('input', (e) => {
            const query = e.target.value.toLowerCase();
            const filtered = products.filter(p => p.name.toLowerCase().includes(query) || p.description.toLowerCase().includes(query));
            productGrid.innerHTML = '';
            
            if (filtered.length === 0) {
                productGrid.innerHTML = `<p class="col-span-full text-center py-10 text-stone-500">Nenhum produto encontrado para "${query}".</p>`;
                return;
            }

            filtered.forEach(product => {
                renderProducts();
            });
        });

        // Menu Mobile
        document.getElementById('mobile-menu-btn').addEventListener('click', () => {
            document.getElementById('mobile-menu').classList.toggle('hidden');
        });

        // Newsletter Submit
        document.getElementById('newsletter-form').addEventListener('submit', (e) => {
            e.preventDefault();
            showToast("Obrigada! Cupom de 10% enviado ao seu e-mail.");
            e.target.reset();
        });

        // Onload
        window.onload = () => {
            renderProducts();
        };
    </script>
</body>
</html>
